---
/**
 * BottomNav.astro
 * -----------------------------------------------------------------------------
 * Mobile-only bottom navigation with 5 tabs + a floating SOS heart button.
 *
 * Tabs (in order):   Today  /  Sit  /  Rest  /  Breathe  /  Listen
 * Routes:            /today   /sit    /rest    /breathe    /be-with-me
 *
 * SOS button:
 *   - Floating, bottom-right, above the nav bar.
 *   - Anchors to /now  (the immediate-help page — grounding + hotlines).
 *   - Uses a hand-drawn inline SVG heart. NEVER an emoji: emoji rendering
 *     is vendor-dependent and the OS heart glyph can look flippant on
 *     Android/Windows. The SVG is the same everywhere.
 *
 * Hidden at >= 768px (desktop). Desktop uses Snowpeak's top nav.
 */

const currentPath = Astro.url.pathname;
const tabs = [
  { href: '/today',       label: 'Today',   hi: 'आज',       icon: 'sun'    },
  { href: '/sit',         label: 'Sit',     hi: 'बैठें',     icon: 'lotus'  },
  { href: '/rest',        label: 'Rest',    hi: 'विश्राम',   icon: 'moon'   },
  { href: '/breathe',     label: 'Breathe', hi: 'साँस',     icon: 'wind'   },
  { href: '/be-with-me',  label: 'Listen',  hi: 'सुनें',     icon: 'ear'    },
];

const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(href + '/');
---

<nav class="sk-bottom-nav" aria-label="Primary / मुख्य नेविगेशन">
  <ul class="sk-bottom-nav__list">
    {tabs.map(t => (
      <li>
        <a
          href={t.href}
          class={`sk-bottom-nav__link ${isActive(t.href) ? 'is-active' : ''}`}
          aria-current={isActive(t.href) ? 'page' : undefined}
        >
          <span class="sk-bottom-nav__icon" aria-hidden="true">
            {t.icon === 'sun' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/>
              </svg>
            )}
            {t.icon === 'lotus' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 4c-1.5 3-1.5 6 0 9 1.5-3 1.5-6 0-9z"/>
                <path d="M4 13c2 4 5 5 8 5s6-1 8-5c-2 0-4 1-5 3-1-3-3-3-3-3s-2 0-3 3c-1-2-3-3-5-3z"/>
              </svg>
            )}
            {t.icon === 'moon' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>
              </svg>
            )}
            {t.icon === 'wind' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M3 8h11a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h9"/>
              </svg>
            )}
            {t.icon === 'ear' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 20c-2 0-3-1.5-3-4 0-2 1-3 1-5a6 6 0 1 1 12 0c0 3-3 3-3 6 0 2-2 3-4 3z"/>
                <path d="M11 10a2 2 0 1 1 3 1.7c-1 .5-1.5 1-1.5 2"/>
              </svg>
            )}
          </span>
          <span class="sk-bottom-nav__label">
            <span class="sk-bottom-nav__en">{t.label}</span>
            <span class="sk-bottom-nav__hi sk-hindi" lang="hi">{t.hi}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<a
  href="/now"
  class="sk-sos"
  aria-label="I need help right now / अभी मदद चाहिए"
>
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
    <path
      d="M12 20.5s-7-4.4-9-8.5C1.5 8.9 3.4 5.5 6.8 5.5c1.9 0 3.4 1 4.2 2.4l1 1.6 1-1.6c.8-1.4 2.3-2.4 4.2-2.4 3.4 0 5.3 3.4 3.8 6.5-2 4.1-9 8.5-9 8.5z"
      fill="currentColor"
    />
  </svg>
  <span class="sk-sos__label">Help</span>
</a>

<style>
  .sk-bottom-nav {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 90;
    background: color-mix(in oklab, var(--sk-night) 92%, black);
    border-top: 1px solid var(--sk-border);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }
  .sk-bottom-nav__list {
    list-style: none;
    margin: 0;
    padding: 6px 4px 4px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2px;
  }
  .sk-bottom-nav__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 6px 2px;
    color: color-mix(in oklab, var(--sk-cream) 65%, transparent);
    text-decoration: none;
    font-size: 11px;
    line-height: 1.2;
    border-radius: 10px;
  }
  .sk-bottom-nav__link.is-active {
    color: var(--sk-cream);
    background: color-mix(in oklab, var(--sk-tulsi-sage) 14%, transparent);
  }
  .sk-bottom-nav__link:focus-visible {
    outline: 2px solid var(--sk-tulsi-sage);
    outline-offset: -2px;
  }
  .sk-bottom-nav__icon {
    display: block;
    line-height: 0;
  }
  .sk-bottom-nav__label {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.15;
  }
  .sk-bottom-nav__hi {
    font-size: 10px;
    opacity: 0.7;
  }

  /* Floating SOS — bottom-right, above the nav bar. */
  .sk-sos {
    position: fixed;
    right: 16px;
    bottom: calc(72px + env(safe-area-inset-bottom, 0));
    z-index: 95;
    width: 60px;
    height: 60px;
    border-radius: 999px;
    background: var(--sk-saffron);
    color: var(--sk-night);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 10px;
    font-weight: 600;
    box-shadow: 0 8px 24px color-mix(in oklab, var(--sk-night) 60%, transparent),
                0 2px 6px color-mix(in oklab, var(--sk-night) 40%, transparent);
  }
  .sk-sos:active {
    transform: translateY(1px);
  }
  .sk-sos:focus-visible {
    outline: 3px solid var(--sk-crisis-lavender);
    outline-offset: 3px;
  }
  .sk-sos__label {
    margin-top: -2px;
    letter-spacing: 0.04em;
  }

  /* Desktop: hide both nav and SOS — desktop has Snowpeak's top nav. */
  @media (min-width: 768px) {
    .sk-bottom-nav,
    .sk-sos {
      display: none;
    }
  }
</style>
